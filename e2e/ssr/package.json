{
  "name": "e2e-ssr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite",
    "build": "tsc && vite build",
    "server:e2e": "cross-env SERVE=1 NODE_ENV=production PORT=5192 tsx src/server.ts",
    "cy:run": "cypress run",
    "test": "pnpm run build && concurrently -k -s first -n ssr,cy \"pnpm run server:e2e\" \"wait-on -t 120000 http-get://127.0.0.1:5192 && pnpm run cy:run\""
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.25.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.17.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "cypress": "^13.17.0",
    "tsx": "^4.21.0",
    "vite": "^7.3.1",
    "vite-plugin-kiru": "workspace:^",
    "wait-on": "^8.0.5"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.1",
    "hono": "^4.12.17",
    "kiru": "workspace:^"
  }
}
