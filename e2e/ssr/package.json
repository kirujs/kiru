{
  "name": "e2e-ssr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite",
    "build": "vite build",
    "server:e2e": "cross-env NODE_ENV=production PORT=5192 node dist/server",
    "cy:run": "cypress run",
    "cy:debug": "cypress run --spec 'cypress/e2e/debug-*.cy.ts'",
    "test:shard-core": "pnpm exec cypress run --config-file cypress.shard-core.config.ts",
    "test:shard-loaders": "pnpm exec cypress run --config-file cypress.shard-loaders.config.ts",
    "test:shard-streaming": "pnpm exec cypress run --config-file cypress.shard-streaming.config.ts",
    "test:shard-actions": "pnpm exec cypress run --config-file cypress.shard-actions.config.ts",
    "test:tier3": "pnpm exec cypress run --config-file cypress.tier3.config.ts",
    "test": "pnpm run build && node ./scripts/verify-hybrid-prerender.mjs && node ./scripts/concurrent-request-context.mjs && pnpm run test:shard-core && pnpm run test:shard-loaders && pnpm run test:shard-streaming && pnpm run test:shard-actions && pnpm run test:tier3"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.17.0",
    "cross-env": "^10.1.0",
    "cypress": "^15.16.0",
    "vite": "^7.3.1",
    "vite-plugin-kiru": "workspace:^"
  },
  "dependencies": {
    "@kirujs/adapter-node": "workspace:^",
    "kiru": "workspace:^"
  }
}
