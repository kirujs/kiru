{
  "name": "e2e-ssg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "preview:e2e": "vite preview --port 5191 --strictPort --host 127.0.0.1",
    "cy:run": "cypress run",
    "test": "pnpm run build && concurrently -k -s first -n preview,cy \"pnpm run preview:e2e\" \"wait-on -t 120000 http-get://127.0.0.1:5191 && pnpm run cy:run\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.17.0",
    "concurrently": "^9.2.0",
    "cypress": "^13.17.0",
    "wait-on": "^8.0.5",
    "vite": "^7.3.1",
    "vite-plugin-kiru": "workspace:^"
  },
  "dependencies": {
    "kiru": "workspace:^"
  }
}
