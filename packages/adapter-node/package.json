{
  "name": "@kirujs/adapter-node",
  "version": "1.0.0",
  "description": "Node.js deploy adapter for Kiru SSR and hybrid ISR",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "default": "./dist/hono.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/**/*.test.js"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/kirujs/kiru",
    "directory": "packages/adapter-node"
  },
  "peerDependencies": {
    "kiru": ">=1.5.0",
    "sharp": ">=0.33.0",
    "hono": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "sharp": { "optional": true },
    "hono": { "optional": true }
  },
  "dependencies": {
    "@kirujs/runtime": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "hono": "^4.12.17",
    "kiru": "workspace:^",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  }
}
