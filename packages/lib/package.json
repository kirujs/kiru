{
  "name": "kiru",
  "version": "1.5.3",
  "description": "A batteries-included, easy-to-use rendering library with a tiny footprint",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "homepage": "https://kirujs.dev",
  "author": "LankyMoose",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/kirujs/kiru"
  },
  "keywords": [
    "kiru",
    "kirujs",
    "kiru.js",
    "dom",
    "jsx",
    "html",
    "virtual-dom",
    "reactive",
    "signal"
  ],
  "scripts": {
    "build": "pnpm i && tsc",
    "test": "cross-env NODE_ENV=development node --test dist/**/*.test.js",
    "dev": "tsc --watch"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./ssr/client": {
      "types": "./dist/ssr/client.d.ts",
      "default": "./dist/ssr/client.js"
    },
    "./ssr/server": {
      "types": "./dist/ssr/server.d.ts",
      "default": "./dist/ssr/server.js"
    },
    "./ssr/router": {
      "types": "./dist/ssr/routerHydrate.d.ts",
      "default": "./dist/ssr/routerHydrate.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "browser": "./dist/router/client.js",
      "default": "./dist/router/index.js"
    },
    "./router/csr": {
      "types": "./dist/router/bootstrap/csr.d.ts",
      "default": "./dist/router/bootstrap/csr.js"
    },
    "./router/ssr": {
      "types": "./dist/router/bootstrap/ssr.d.ts",
      "default": "./dist/router/bootstrap/ssr.js"
    },
    "./router/ssg": {
      "types": "./dist/router/bootstrap/ssg.d.ts",
      "default": "./dist/router/bootstrap/ssg.js"
    },
    "./remote": {
      "types": "./dist/remote/index.d.ts",
      "browser": "./dist/remote/browser.js",
      "default": "./dist/remote/index.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx.d.ts",
      "default": "./dist/jsx.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx.d.ts",
      "default": "./dist/jsx.js"
    }
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "@types/chai": "^5.2.3",
    "@types/jsdom": "^27.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "chai": "^6.2.2",
    "jsdom": "^27.4.0",
    "ts-mocha": "^11.1.0",
    "typescript": "^5.9.3"
  }
}
