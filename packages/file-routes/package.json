{
  "name": "@kirujs/file-routes",
  "version": "1.0.0",
  "description": "File-based route tree scanner and codegen for Kiru",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "cross-env NODE_ENV=development tsx --test src/**/*.test.ts"
  },
  "license": "ISC",
  "dependencies": {
    "tinyglobby": "0.2.15"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "cross-env": "^10.1.0",
    "kiru": "workspace:^",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kirujs/kiru",
    "directory": "packages/file-routes"
  }
}
