{
  "compilerOptions": {
    "types": ["kiru"],
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "lib": ["ES2020"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "preserve"
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
